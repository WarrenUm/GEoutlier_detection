# Connection to the InfluxDB 3 Enterprise store owned by the python_InfluxDB
# project. Copy this file to .env and fill in real values. Keep .env git-ignored.
# See .kiro/steering/data-access.md for details.

# Base URL of the InfluxDB 3 store (HTTP + Flight/gRPC share this port).
# Default to the remote server for the live deployment; use localhost:8181 for
# a portable single-host setup.
INFLUXDB3_HOST_URL=http://192.168.1.85:8181

# Any non-empty token works while the store runs with --without-auth in local
# dev. Do NOT commit a real secret.
INFLUXDB3_AUTH_TOKEN=any-non-empty-token

# Database holding the OSRS Grand Exchange price data.
INFLUXDB3_DATABASE_NAME=GEItemPrices
